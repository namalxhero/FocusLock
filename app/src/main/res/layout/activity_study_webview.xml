<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/studyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0F">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#0D1117">

        <!-- Back button -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#7FDBBB"
            android:textSize="22sp"
            android:background="#1A2A25"
            android:padding="6dp" />

        <!-- Search bar -->
        <EditText
            android:id="@+id/searchBar"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="#1A1A28"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="Search study topics..."
            android:textColorHint="#44445A"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true" />

        <!-- Search button -->
        <TextView
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🔍"
            android:textSize="18sp"
            android:background="#1A3A2A"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Keyword chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:scrollbars="none"
        android:background="#0D1117"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </HorizontalScrollView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A2A" />

    <!-- WebView -->
    <WebView
        android:id="@+id/studyWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
